{
  "name": "fcfa-kit",
  "version": "0.1.0",
  "description": "Zero-dependency TypeScript toolkit for the CFA franc zone (XAF & XOF): formatting, parsing, amounts in words, plus per-country modules (phone numbers, reference data).",
  "keywords": [
    "fcfa",
    "cfa",
    "xaf",
    "xof",
    "franc-cfa",
    "currency",
    "format",
    "phone",
    "cameroon",
    "cemac",
    "uemoa",
    "typescript"
  ],
  "license": "MIT",
  "author": "Mooktar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YOUR-USERNAME/fcfa-kit.git"
  },
  "bugs": {
    "url": "https://github.com/YOUR-USERNAME/fcfa-kit/issues"
  },
  "homepage": "https://github.com/YOUR-USERNAME/fcfa-kit#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./cm": {
      "import": {
        "types": "./dist/cm.d.ts",
        "default": "./dist/cm.js"
      },
      "require": {
        "types": "./dist/cm.d.cts",
        "default": "./dist/cm.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "cm": [
        "./dist/cm.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "README.fr.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check:package": "publint && attw --pack . --profile node16",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.1.2",
    "publint": "^0.3.25",
    "tsup": "^9.0.0",
    "typescript": "~5.9.3",
    "vitest": "^5.1.2"
  }
}
